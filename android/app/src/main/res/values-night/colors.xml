<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Koyu tema. Bu dosya yalnız uygulama koyu göründüğünde okunuyor: gece modu
      telefonun değil uygulamanın tercihine bağlı (tema/TemaAyari.kt). "Açık"
      seçen kullanıcı telefon gece modundayken de values/colors.xml'i görür.

      Değerler web'in koyu takımıyla aynı (globals.css, data-tema koyu): zemin
      background, metin foreground, soluk muted-foreground, çip muted, çizgi
      border. Zemin üç yerde (açılış, WebView arkası, engel katmanı) ve web
      açılış katmanıyla aynı olmalı, yoksa açılışta renk sıçrar.
    -->
    <color name="acilis_zemin">#1A1612</color>
    <color name="uygulama_zemin">#1A1612</color>
    <color name="odak_zemin">#1A1612</color>
    <color name="marka_amber">#D9622F</color>
    <color name="odak_metin">#F2EBE4</color>
    <color name="odak_soluk">#AB9F94</color>
    <color name="odak_cip">#312A24</color>
    <color name="odak_cizgi">#3A322B</color>

    <!--
      Bildirim renkleri aynı kalıyor: bildirim uygulamanın değil telefonun
      temasında çiziliyor ve bu tonlar zaten iki zemin için birden seçildi.
    -->
    <color name="bildirim_amber">#E8783F</color>
    <color name="bildirim_cizgi">#33888888</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Uyarlanabilir ikonun zemini.

  Düz tek renk de olurdu ama ikon telefonun duvar kâğıdının üstünde tek başına
  duruyor ve düz turuncu bir kare, yanındaki uygulamaların hepsinden daha yassı
  görünüyordu. Açı 315: ışık sol üstte, koyu ton sağ altta — public/icon-512.png
  ile aynı yön (scripts/ikon-uret.mjs).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <gradient
      android:type="linear"
      android:angle="315"
      android:startColor="@color/ic_launcher_background"
      android:endColor="@color/ic_launcher_background_koyu" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Sistem açılış ekranının "ikonu" — bilerek **saydam**.

  Android 12+ açılış ekranı kapatılamıyor; `windowSplashScreenAnimatedIcon`
  verilmezse sistem uygulama simgesini koyuyor. Uygulamanın kendi açılış ekranı
  (components/acilis.tsx) maskotu yukarıdan indirdiği için burada ikinci bir
  maskot, inen tavşanın üstüne duran bir tavşan koymak olurdu.

  Saydam bir şekil konunca sistem ekranından geriye yalnızca zemin rengi kalıyor;
  o renk de uygulamanınkiyle aynı olduğu için tek bir açılış görünüyor.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <size android:width="1dp" android:height="1dp" />
  <solid android:color="@android:color/transparent" />
</shape>

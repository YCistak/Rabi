<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!--
          Capacitor şablonunda burası @null'dı. Açılış ekranı kapandıktan sonra
          WebView ilk kareyi boyayana kadar arkada hiçbir şey olmadığı için
          siyah bir kare yanıp sönüyordu.

          Renk uygulamanın temasını değil **açılış ekranının** zeminini izliyor:
          bu boşlukta ekranda hâlâ açılış görünüyor olmalı. Temaya bağlıyken
          koyu modda o kare neredeyse siyahtı ve mor sistem ekranıyla mor açılış
          ekranının arasına siyah bir kare giriyordu — kullanıcının gördüğü üç
          ekranın ortadakiydi.
        -->
        <item name="android:background">@color/acilis_zemin</item>
        <item name="android:windowBackground">@color/acilis_zemin</item>
    </style>

    <!--
      Sistem açılış ekranı.

      Android 12+ sistemin kendi açılış ekranını çizmek zorunda; kapatılamıyor.
      Burada yalnızca **zemin rengi** bırakıldı: ikon saydam (`acilis_bos`),
      animasyon yok. Uygulamanın kendi açılış ekranı (components/acilis.tsx)
      aynı zeminde tavşanı, "Rabi" yazısını ve çarkı gösteriyor — ikisi de ikon
      gösterseydi arka arkaya iki açılış ekranı izleniyordu.

      `postSplashScreenTheme` şart: açılış bitince etkinlik bu temada kalıyor,
      yoksa uygulama teması hiç uygulanmıyor.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/acilis_zemin</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/acilis_bos</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!--
          Capacitor şablonunda burası @null'dı. Açılış ekranı kapandıktan sonra
          WebView ilk kareyi boyayana kadar arkada hiçbir şey olmadığı için
          siyah bir kare yanıp sönüyordu. Uygulamanın kendi zemin rengi konuldu
          (values-night altında koyu karşılığı var).
        -->
        <item name="android:background">@color/uygulama_zemin</item>
        <item name="android:windowBackground">@color/uygulama_zemin</item>
    </style>

    <!--
      Açılış ekranı.

      Capacitor'ın şablonu `Theme.SplashScreen` altında `android:background`
      veriyordu; o özellik bu tema tarafından **kullanılmıyor**. Android 12+
      sistemin kendi açılış ekranını çiziyor ve yalnızca aşağıdaki
      `windowSplashScreen*` özelliklerine bakıyor — sonuç siyah ekrandı.

      `postSplashScreenTheme` de eksikti: açılış bitince etkinlik bu temada
      kalıyor, uygulama teması hiç uygulanmıyordu.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/acilis_zemin</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/acilis_maskot</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Pomodoro bildiriminin açık hâli — kullanıcı gölgede bildirimi aşağı
  çektiğinde ya da kilit ekranında yer olduğunda görünen düzen.

  Kapalı hâlden farkı ölçek değil **sıra**: orada satır tek ve sayı sağda
  duruyor, burada sayı ortada ve ekrandaki en büyük öge. Bildirime bakma sebebi
  o sayı; açık hâlde yer varken onu bir satırın ucuna sıkıştırmak, kazanılan
  yeri boşa harcamak olurdu.

  Düğmeler bu düzende yok: onları sistem çiziyor (`Notification.Builder.addAction`
  + `DecoratedCustomViewStyle`). Elle çizilen düğmeler her Android sürümünde ve
  her üreticinin gölgesinde başka türlü duruyor; sistemin kendi düğmesi her
  yerde tıklanabilir ve doğru boyda.

  ## İçerik ortalanmıyor, sola yaslanıyor

  Bir süre `center_horizontal`dı ve bildirim gözle görülür biçimde **sağa
  kaymış** duruyordu. Sebep düzende değil, düzenin oturduğu yerde:
  `DecoratedCustomViewStyle` özel görünümü kartın tamamına değil, solunda
  uygulama simgesi için yer ayrılmış bir şeride koyuyor. Ekran görüntüsünden
  ölçüldü — kartın kendisi 30..893 piksel, şerit 150..855: solda 120, sağda 38
  piksel pay var. Şeridin ortası kartın ortasından 41 piksel sağda kalıyor ve
  "ortalanmış" her şey oraya oturuyor; maskotun, sürenin ve çubuğun ölçülen
  merkezi 502,5 iken kartınki 461,5'ti.

  Payı sayıyla dengelemek denenebilir görünüyor ve yanlış: o iki sayı Android
  sürümüne ve üreticinin gölgesine göre değişiyor, sabit bir dolgu bir
  telefonda düzeltip ötekinde ters yöne bozardı.

  Sola yaslamak ölçüden bağımsız çalışıyor, üstelik doğru hizayı veriyor:
  sistemin kendi çizdiği "Rabi" başlığı ve alttaki düğmeler zaten şeridin sol
  kenarından başlıyor. Üçü aynı çizgide durunca bildirim tek parça okunuyor.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/odak_hale" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/tavsan_yuz" />
    </FrameLayout>

    <!-- Aşama ve ders tek satırda: "Çalışma · Matematik". İkiye bölünseydi
         bildirim iki satır uzar, kazanılan bilgi aynı kalırdı.

         Kendi hizası ayrıca yazılı: kutusu `match_parent` olduğu için kabın
         `gravity`si buraya ulaşmıyor, yazıyı kutunun içinde konumlandıran şey
         bu satır. Yazılmasaydı satır sola yaslanmış bir kabın içinde tek
         başına ortalanmış kalırdı. -->
    <TextView
        android:id="@+id/bildirim_genis_asama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bildirim_genis_sure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.02"
        android:textColor="@color/bildirim_amber"
        android:textSize="42sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/bildirim_genis_cubuk"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progressDrawable="@drawable/bildirim_cubuk" />
</LinearLayout>

# bağımlılıklar
node_modules/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Capacitor'ın ürettikleri (cap sync her seferinde yeniden yazar)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
android/capacitor-cordova-android-plugins/

# Android build çıktıları
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# Derlenmiş APK'lar — her güncellemede kök dizine bir tane çıkıyor, 20 MB'ın
# üstündeler ve depoda tutulacak bir şey değiller
*.apk

# Firebase yapılandırması — depo herkese açık.
#
# İçindeki Android API anahtarı teknik olarak "gizli" değil (paketin içinden
# zaten okunabiliyor) ama proje numarası, uygulama kimliği ve depo adresiyle
# birlikte durması gereksiz. Dosya olmadan da derleme çalışıyor
# (`android/app/build.gradle` başındaki koşul), yalnızca çökme raporlaması
# kapalı derleniyor. CI bunu `GOOGLE_SERVICES_JSON` secret'ından yazıyor.
android/app/google-services.json

# İmza anahtarları ve şifreleri asla depoya girmemeli
*.jks
*.keystore
android/keystore.properties

# işletim sistemi / editör
.DS_Store
.vscode/

# Kişisel notlar — uzantılı/uzantısız her hâli.
#
# Dikkat: desen tüm ağaçta geçerli, yalnızca kökte değil. Kaynak dosyaya
# "notlar" adını vermek onu sessizce depodan da Tailwind'in tarayıcısından da
# düşürüyor (yaşandı: Yapılacaklar tahtası `lib/yapilacaklar.ts` adını bu
# yüzden taşıyor).
eklenecekler
eklenecekler.*
notlar
notlar.*

# Denetim raporları ve istatistik betiği — makinede üretilip okunuyor, depoya
# girmesi gerekmiyor. reports/ altındaki Play denetim çıktıları her koşuda
# yeniden yazılıyor.
reports/
.istatistik.mts

# Sürüm alma kılavuzu — makinedeki kuruluma özgü yollar ve JDK sürümleri
# içeriyor, kişisel bir not defteri gibi tutuluyor.
RELEASE.md
